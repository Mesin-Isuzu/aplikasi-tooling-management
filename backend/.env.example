# Server
PORT=3000

# MySQL connection
# Produksi (Railway): plugin MySQL menyediakan DATABASE_URL otomatis — tidak perlu diisi.
# Lokal (XAMPP/Laragon): pakai DATABASE_URL atau MYSQL_* di bawah.
DATABASE_URL=mysql://user:password@localhost:3306/dtms
# Alternatif koneksi per-field jika DATABASE_URL tidak tersedia
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=dtms

# JWT
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRES=7d

# CORS: origin frontend, pisahkan dengan koma
FRONTEND_URL=http://localhost:9999,http://localhost:5500

# URL publik backend (untuk membangun URL file upload)
PUBLIC_API_URL=

# Auto-seed database saat kosong (true/false)
AUTO_SEED=true
